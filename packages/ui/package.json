{
  "name": "@mirage/ui",
  "version": "0.7.0",
  "description": "The React components behind Mirage's React export. Same markup as the HTML export.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": { ".": "./dist/index.js", "./mirage.css": "./dist/mirage.css" },
  "files": ["dist", "src"],
  "sideEffects": ["*.css"],
  "peerDependencies": { "react": ">=17" },
  "scripts": {
    "build": "esbuild src/index.jsx --outfile=dist/index.js --format=esm --jsx=automatic --external:react --external:react/jsx-runtime && node ../../cli/mirage.mjs css --out dist/mirage.css"
  },
  "devDependencies": { "esbuild": "^0.24.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Veer1778/Mirage", "directory": "packages/ui" }
}
